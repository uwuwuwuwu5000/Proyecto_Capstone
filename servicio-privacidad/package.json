{
  "name": "@ciudad-alerta/servicio-privacidad",
  "version": "0.1.0",
  "private": true,
  "description": "Difumina rostros y personas en las fotos de los reportes de Ciudad Alerta, en la nube, con los mismos modelos y umbrales que usaba la app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/compilar.mjs",
    "start": "node dist/servidor.mjs",
    "test": "vitest run",
    "tipos": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/face_detection": "0.4.1646425229",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow-models/face-detection": "1.0.3",
    "@tensorflow-models/mobilenet": "2.1.1",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "jose": "6.1.0",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
