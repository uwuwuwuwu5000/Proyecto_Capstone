{
  "name": "portal-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-ciudad-alerta \"playwright test\"",
    "test:e2e:ui": "playwright test --ui",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-ciudad-alerta \"vitest run --config vitest.reglas.config.ts\""
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/supercluster": "^7.1.3",
    "firebase": "^12.18.0",
    "geofire-common": "^6.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
