rules_version = '2';

// CA-79 · Reglas de seguridad iniciales de Ciudad Alerta.
// Principio: nada es público. Toda lectura o escritura exige sesión activa y,
// en el caso de los perfiles, que el documento pertenezca a quien lo solicita.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funciones auxiliares ---------------------------------------------

    function estaAutenticado() {
      return request.auth != null;
    }

    function esPropietario(userId) {
      return estaAutenticado() && request.auth.uid == userId;
    }

    /**
     * Administradores por correo.
     *
     * Duplicada a propósito en src/app/core/admin-emails.ts. Esta es la que
     * manda: se evalúa contra el correo del token de autenticación, que emite
     * Firebase y el cliente no puede falsificar. Al modificar la lista hay que
     * actualizar ambos archivos y volver a desplegar.
     */
    function esCorreoAdministrador() {
      // DIAG-2 · Solo con el correo verificado: si no, quien registrara
      // primero un correo de la lista (sin ser su dueño) nacería admin.
      return estaAutenticado()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'es.ibarra@duocuc.cl',
             'cla.torres@duocuc.cl',
             'rodri.hernandezc@duocuc.cl',
             'rodri.hernandezc@admin.cl',
             'rodrigo@admin.cl'
           ];
    }

    /** Rol admin estricto: el operador gestiona incidencias, no catálogos. */
    function esAdministrador() {
      return estaAutenticado()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function esGestor() {
      return estaAutenticado()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['operador', 'admin'];
    }

    /**
     * Quién puede gestionar (cambiar de estado) un reporte concreto: un admin
     * cualquiera, o una cuenta operador cuyo operadorId sea el asignado al
     * reporte y cuyo operador siga activo. Un reporte sin operadorId solo lo
     * gestiona un admin.
     */
    function puedeGestionarReporte(reporte) {
      let perfil = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return estaAutenticado()
        && (
             perfil.role == 'admin'
             || (
                  perfil.role == 'operador'
                  && perfil.get('operadorId', null) is string
                  && reporte.get('operadorId', null) == perfil.operadorId
                  && get(/databases/$(database)/documents/operadores/$(perfil.operadorId)).data.activo == true
                )
           );
    }

    /** Las cuentas operador no confirman reportes: los gestionan. */
    function esCuentaOperador() {
      let perfil = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(perfil) && get(perfil).data.role == 'operador';
    }

    // ======================================================================
    // SISTEMA DE CONFIANZA (ver sistema_confianza.md)
    // ======================================================================

    function rutaConfianza(uid) {
      return /databases/$(database)/documents/users/$(uid)/confianza/actual;
    }

    /** Datos de confianza de un usuario; sin documento equivale a nivel 0. */
    function confianzaDe(uid) {
      let ruta = rutaConfianza(uid);
      return exists(ruta)
        ? get(ruta).data
        : {'puntosConfianza': 0, 'trustLevel': 0, 'validatedReports': 0,
           'reportesFalsos': 0, 'confirmacionesSuspendidas': false};
    }

    /** Nivel (0-10) que corresponde a unos puntos de confianza (sección 4.1). */
    function nivelDePuntos(pc) {
      return pc >= 760 ? 10
           : pc >= 640 ? 9
           : pc >= 530 ? 8
           : pc >= 430 ? 7
           : pc >= 340 ? 6
           : pc >= 260 ? 5
           : pc >= 190 ? 4
           : pc >= 130 ? 3
           : pc >= 80 ? 2
           : pc >= 40 ? 1
           : 0;
    }

    /** Peso de una confirmación según el nivel (sección 4.2): 10 x (1 + 0,25 x nivel), máximo 34. */
    function pesoDeNivel(nivel) {
      return nivel >= 10 ? 34 : 10 + 2.5 * nivel;
    }

    /** Confirmaciones por día según el nivel (sección 4.5). */
    function limiteDiario(nivel) {
      return nivel == 0 ? 5
           : nivel == 1 ? 8
           : nivel <= 3 ? 12
           : nivel <= 6 ? 20
           : 30;
    }

    /** Número de día con desfase fijo UTC-3: identifica el documento del contador. */
    function numeroDeDia() {
      // La división entre enteros ya trunca: no hace falta redondear.
      return (request.time.toMillis() - 10800000) / 86400000;
    }

    function rutaLimiteDeHoy(uid) {
      return /databases/$(database)/documents/users/$(uid)/limites/$(string(numeroDeDia()));
    }

    function rutaConfirmacion(reportId, uid) {
      return /databases/$(database)/documents/reports/$(reportId)/confirmations/$(uid);
    }

    function validacionDe(reporte) {
      return reporte.get('validacion', {});
    }

    /** Mapa `validacion` de un reporte nuevo: todo en cero. */
    function validacionInicial(v) {
      return v is map
        && v.keys().hasOnly(['puntos', 'votos', 'validado', 'validadoAt', 'veredicto'])
        && v.get('puntos', 0) == 0
        && v.get('votos', 0) == 0
        && v.get('validado', false) == false
        && v.get('validadoAt', null) == null
        && v.get('veredicto', null) == null;
    }

    /**
     * La confirmación comunitaria con peso (formato nuevo). Se evalúa al crear
     * `confirmations/{uid}`: exige que en el mismo lote vayan la suma en el
     * reporte y el contador del día.
     */
    function confirmacionConPesoValida(reportId, userId) {
      let datos = request.resource.data;
      let perfil = get(/databases/$(database)/documents/users/$(userId)).data;
      let conf = confianzaDe(userId);
      let nivel = conf.get('trustLevel', 0);
      let verificado = request.auth.token.email_verified == true;
      let antiguo = perfil.get('createdAt', null) != null
        && request.time.toMillis() - perfil.createdAt.toMillis() >= 86400000;
      let peso = (verificado && antiguo) ? pesoDeNivel(nivel) : 0;
      let rutaLim = rutaLimiteDeHoy(userId);
      let hoyAntes = exists(rutaLim) ? get(rutaLim).data.confirmaciones : 0;
      let reporte = datosReporte(reportId);
      let despues = getAfter(/databases/$(database)/documents/reports/$(reportId)).data;
      return datos.keys().hasOnly(['uid', 'reportId', 'createdAt', 'nivel', 'peso'])
        && datos.nivel == nivel
        && datos.peso == peso
        && conf.get('confirmacionesSuspendidas', false) == false
        // Contador del día: +1, sin pasar del límite, y la pausa de 20 s.
        && existsAfter(rutaLim)
        && getAfter(rutaLim).data.confirmaciones == hoyAntes + 1
        && hoyAntes + 1 <= limiteDiario(nivel)
        && (!exists(rutaLim)
            || request.time.toMillis() - get(rutaLim).data.ultimaAt.toMillis() >= 20000)
        // La suma del reporte viaja en el mismo lote.
        && validacionDe(despues).get('puntos', 0) == validacionDe(reporte).get('puntos', 0) + peso
        && validacionDe(despues).get('votos', 0) == validacionDe(reporte).get('votos', 0) + (peso > 0 ? 1 : 0);
    }

    /**
     * Un vecino suma su confirmación al mapa `validacion` del reporte. Solo
     * toca puntos, votos y validado, y solo junto a su documento de confirmación.
     */
    function sumaDeConfirmacionValida(reportId) {
      let nuevo = request.resource.data;
      let antes = resource.data;
      let cambios = nuevo.diff(antes).affectedKeys();
      let vNuevo = validacionDe(nuevo);
      let vAntes = validacionDe(antes);
      let rutaConf = rutaConfirmacion(reportId, request.auth.uid);
      let peso = existsAfter(rutaConf) ? getAfter(rutaConf).data.get('peso', 0) : 0;
      let puntos = vAntes.get('puntos', 0) + peso;
      let votos = vAntes.get('votos', 0) + (peso > 0 ? 1 : 0);
      let validado = vAntes.get('validado', false) || (puntos >= 100 && votos >= 3);
      return cambios.hasOnly(['validacion'])
        && vNuevo.diff(vAntes).affectedKeys()
             .hasOnly(['puntos', 'votos', 'validado', 'validadoAt', 'veredicto'])
        && vNuevo.get('veredicto', null) == vAntes.get('veredicto', null)
        && existsAfter(rutaConf)
        && !exists(rutaConf)
        && vNuevo.puntos == puntos
        && vNuevo.votos == votos
        && vNuevo.validado == validado
        && (validado == vAntes.get('validado', false)
              ? vNuevo.get('validadoAt', null) == vAntes.get('validadoAt', null)
              : vNuevo.validadoAt == request.time);
    }

    /**
     * Veredicto de un gestor sobre un reporte. Solo toca el bloque de
     * veredicto de `validacion` y `updatedAt`, y exige que en el mismo lote
     * vayan los puntos del autor (confianza/actual).
     */
    function veredictoValido(reportId) {
      let nuevo = request.resource.data;
      let antes = resource.data;
      let vNuevo = validacionDe(nuevo);
      let vAntes = validacionDe(antes);
      let autor = antes.uid;
      let confDespues = getAfter(rutaConfianza(autor));
      return nuevo.diff(antes).affectedKeys().hasOnly(['validacion', 'updatedAt'])
        && nuevo.updatedAt == request.time
        && vNuevo.diff(vAntes).affectedKeys().hasOnly(
             ['veredicto', 'veredictoPor', 'veredictoAt', 'veredictoComentario', 'veredictoPuntos'])
        && vAntes.get('veredicto', null) == null
        && vNuevo.veredicto in ['real', 'falso']
        && vNuevo.veredictoPor == request.auth.uid
        && vNuevo.veredictoAt == request.time
        && (vNuevo.veredicto == 'real'
            || (vNuevo.get('veredictoComentario', null) is string
                && vNuevo.veredictoComentario.matches('.*[^ ].*')
                && vNuevo.veredictoComentario.size() <= 512))
        && vNuevo.veredictoPuntos is int
        && autor != request.auth.uid
        && get(/databases/$(database)/documents/users/$(autor)).data.role == 'ciudadano'
        && existsAfter(rutaConfianza(autor))
        && confDespues.data.ultimoReporteId == reportId;
    }

    /**
     * Puntos del autor tras un veredicto (documento confianza/actual). Se
     * comprueba contra el reporte tal como queda al final del lote.
     */
    function confianzaDeVeredictoValida(userId) {
      let nuevo = request.resource.data;
      let previo = resource == null
        ? {'puntosConfianza': 0, 'validatedReports': 0, 'reportesFalsos': 0,
           'confirmacionesSuspendidas': false}
        : resource.data;
      let reportId = nuevo.ultimoReporteId;
      let rutaReporte = /databases/$(database)/documents/reports/$(reportId);
      let reporteDespues = getAfter(rutaReporte).data;
      let reporteAntes = get(rutaReporte).data;
      let v = validacionDe(reporteDespues);
      let pcAntes = previo.get('puntosConfianza', 0);
      let esReal = v.get('veredicto', null) == 'real';
      let pcNuevo = esReal ? (pcAntes + 10 > 760 ? 760 : pcAntes + 10) : (pcAntes - 15 < 0 ? 0 : pcAntes - 15);
      return nuevo.keys().hasOnly(['puntosConfianza', 'trustLevel', 'validatedReports',
                                   'reportesFalsos', 'confirmacionesSuspendidas',
                                   'ultimoReporteId', 'updatedAt'])
        && nuevo.get('updatedAt', null) == request.time
        && reporteAntes.uid == userId
        && validacionDe(reporteAntes).get('veredicto', null) == null
        && v.get('veredicto', null) in ['real', 'falso']
        && nuevo.puntosConfianza == pcNuevo
        && nuevo.trustLevel == nivelDePuntos(pcNuevo)
        && v.veredictoPuntos == pcNuevo - pcAntes
        && nuevo.validatedReports == previo.get('validatedReports', 0) + (esReal ? 1 : 0)
        && nuevo.reportesFalsos == previo.get('reportesFalsos', 0) + (esReal ? 0 : 1)
        && nuevo.confirmacionesSuspendidas == previo.get('confirmacionesSuspendidas', false)
        && puedeGestionarReporte(reporteAntes);
    }

    /** El espejo en users/{autor} debe coincidir con confianza/actual al final del lote. */
    function espejoDeConfianzaValido(userId) {
      let nuevo = request.resource.data;
      let conf = getAfter(rutaConfianza(userId)).data;
      return esGestor()
        && existsAfter(rutaConfianza(userId))
        && nuevo.diff(resource.data).affectedKeys()
             .hasOnly(['trustLevel', 'validatedReports', 'updatedAt'])
        && nuevo.trustLevel == conf.trustLevel
        && nuevo.validatedReports == conf.validatedReports;
    }

    /** El administrador suspende o rehabilita confirmaciones de un usuario. */
    function suspensionValida() {
      let nuevo = request.resource.data;
      let previo = resource == null
        ? {'puntosConfianza': 0, 'trustLevel': 0, 'validatedReports': 0, 'reportesFalsos': 0}
        : resource.data;
      return esAdministrador()
        && nuevo.get('confirmacionesSuspendidas', null) is bool
        && nuevo.get('puntosConfianza', 0) == previo.get('puntosConfianza', 0)
        && nuevo.get('trustLevel', 0) == previo.get('trustLevel', 0)
        && nuevo.get('validatedReports', 0) == previo.get('validatedReports', 0)
        && nuevo.get('reportesFalsos', 0) == previo.get('reportesFalsos', 0)
        && nuevo.get('ultimoReporteId', null) == previo.get('ultimoReporteId', null);
    }

    // Campos que el cliente no puede fijar ni modificar por su cuenta:
    // el nivel de confianza y el conteo de reportes los administrará el backend
    // (Cloud Functions) cuando se implemente el sistema de reputación.
    function camposProtegidosIntactos() {
      return request.resource.data.trustLevel == resource.data.trustLevel
        && request.resource.data.validatedReports == resource.data.validatedReports
        // DIAG-1 · El operadorId lo asigna un admin al crear la cuenta: si el
        // operador pudiera cambiárselo, gestionaría reportes de otra comuna.
        && request.resource.data.get('operadorId', null) == resource.data.get('operadorId', null)
        && (
             request.resource.data.role == resource.data.role
             // Única promoción de rol admitida: una cuenta de la lista de
             // administradores que todavía figure como ciudadano. Permite
             // regularizar cuentas creadas antes de existir la lista.
             || (request.resource.data.role == 'admin' && esCorreoAdministrador())
           );
    }

    /**
     * `emailVerified` refleja un dato de Firebase Auth. Si una actualización
     * lo modifica, el nuevo valor debe coincidir con el del token, que emite
     * Firebase: nadie puede declararse verificado sin haberlo hecho. Si el
     * campo no cambia, la condición no interviene, para no bloquear otras
     * actualizaciones del perfil.
     */
    /**
     * 1.0 · Aceptación de los términos y la privacidad: la versión es un texto
     * corto y la fecha, la del servidor. Si no cambian, no intervienen.
     */
    function aceptacionDeTerminosValida() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return (!cambios.hasAny(['terminosVersion'])
              || (request.resource.data.terminosVersion is string
                  && request.resource.data.terminosVersion.size() <= 20))
        && (!cambios.hasAny(['terminosAceptadosAt'])
            || request.resource.data.terminosAceptadosAt == request.time);
    }

    function verificacionCoherente() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['emailVerified'])
        || request.resource.data.emailVerified == request.auth.token.email_verified;
    }

    function creacionConValoresIniciales(userId) {
      let datos = request.resource.data;
      return datos.uid == userId
        // 1.1 · Lista blanca: los campos que escriben la app (createUserDocument)
        // y el registro del portal. Sin operadorId: esa cuenta la crea un admin.
        && datos.keys().hasOnly([
             'uid', 'email', 'displayName', 'role', 'trustLevel', 'validatedReports',
             'emailVerified', 'terminosVersion', 'terminosAceptadosAt', 'createdAt', 'updatedAt'
           ])
        && datos.trustLevel == 0
        && datos.validatedReports == 0
        // La antigüedad de la cuenta cuenta para el peso del voto: no se puede falsear.
        && datos.createdAt == request.time
        && (!('updatedAt' in datos) || datos.updatedAt == request.time)
        // Un correo de la lista puede nacer con rol admin; cualquier otro, no.
        && (
             datos.role == 'ciudadano'
             || (datos.role == 'admin' && esCorreoAdministrador())
           )
        && datos.email is string
        && datos.email.size() <= 254
        // 1.1 · Mismo tope que autorNombre en los reportes: un nombre más largo
        // impedía después crear reportes (la app lo recortaba a 60).
        && datos.displayName is string
        && datos.displayName.size() >= 1
        && datos.displayName.size() <= 60
        // Nadie nace «verificado» si el token no lo dice.
        && (datos.get('emailVerified', false) == false
            || datos.emailVerified == request.auth.token.email_verified)
        && (!('terminosVersion' in datos)
            || (datos.terminosVersion is string && datos.terminosVersion.size() <= 20))
        && (!('terminosAceptadosAt' in datos) || datos.terminosAceptadosAt == request.time);
    }

    /**
     * 1.1 · El nombre y el correo del perfil no se cambian a mano: solo al
     * eliminar la cuenta («Cuenta eliminada», correo vacío) o para completar un
     * perfil antiguo que no los tenía. Sin esto, cualquiera podía ponerse el
     * nombre de otra persona (con el que firma sus reportes) o uno enorme.
     */
    function nombreYCorreoDePerfilValidos() {
      let nuevo = request.resource.data;
      let antes = resource.data;
      let nombreAntes = antes.get('displayName', null);
      let nombre = nuevo.get('displayName', null);
      let correoAntes = antes.get('email', null);
      let correo = nuevo.get('email', null);
      return (
               nombre == nombreAntes
               || nombre == 'Cuenta eliminada'
               || (!(nombreAntes is string) && nombre is string && nombre.size() >= 1 && nombre.size() <= 60)
             )
        && (correo == correoAntes || correo == '' || correo == request.auth.token.email);
    }

    /**
     * Alta de una cuenta de organismo (role 'operador') hecha por un admin
     * desde el panel. El propio usuario no puede crear este documento porque
     * todavía no tiene sesión cuando el admin lo da de alta, así que esta
     * rama la firma el admin, no `esPropietario`.
     */
    function creacionCuentaOperador(userId) {
      let datos = request.resource.data;
      return datos.uid == userId
        && datos.role == 'operador'
        && datos.trustLevel == 0
        && datos.validatedReports == 0
        && datos.email is string
        && datos.displayName is string
        && datos.operadorId is string
        && exists(/databases/$(database)/documents/operadores/$(datos.operadorId));
    }

    // --- Perfiles de usuario ----------------------------------------------

    match /users/{userId} {
      // Cada usuario lee y actualiza únicamente su propio documento.
      allow get: if esPropietario(userId);
      allow list: if false;

      // El alta normal la hace cada quien sobre su propio uid; la de una
      // cuenta de organismo la hace un admin desde el panel, firmando con su
      // propia sesión (por eso esa rama no exige esPropietario).
      allow create: if (esPropietario(userId) && creacionConValoresIniciales(userId))
        || (esAdministrador() && creacionCuentaOperador(userId));
      // BUG 64 · Lista blanca explícita: sin ella, un usuario podía agregar
      // campos arbitrarios a su propio documento.
      allow update: if (esPropietario(userId)
        && camposProtegidosIntactos()
        // createdAt no cambia (cuenta antigua = voto con peso). Un perfil sin esa fecha
        // puede completarla una vez, con la hora del servidor.
        && (request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            || (resource.data.get('createdAt', null) == null
                && request.resource.data.createdAt == request.time))
        && verificacionCoherente()
        && aceptacionDeTerminosValida()
        && nombreYCorreoDePerfilValidos()
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'role', 'trustLevel',
             'validatedReports', 'emailVerified', 'ultimoReporteAt',
             'operadorId', 'terminosVersion', 'terminosAceptadosAt',
             'createdAt', 'updatedAt'
           ]))
        // Veredicto de un gestor: el espejo de nivel y reportes validados.
        || espejoDeConfianzaValido(userId);

      // El borrado de cuentas se maneja desde el backend, no desde el cliente.
      allow delete: if false;

      /**
       * Qué avisos ya vio el usuario. Un único documento, `estado`, que solo
       * su dueño lee y escribe. La lista de vistos se acota para que no crezca
       * sin límite; la app la compacta con `vistosHasta` al acercarse al tope.
       */
      /**
       * Datos de confianza: fuente de verdad del nivel. Los leen su dueño y los
       * gestores (para decidir un veredicto); no contienen correo ni nombre.
       * Se escriben solo en el lote de un veredicto (gestor) o al suspender
       * confirmaciones (administrador).
       */
      match /confianza/{docId} {
        allow read: if esPropietario(userId) || esGestor();
        allow create, update: if docId == 'actual'
          && (
               (esGestor() && request.resource.data.get('ultimoReporteId', null) != null
                  && confianzaDeVeredictoValida(userId))
               || suspensionValida()
             );
        allow delete: if false;
      }

      /**
       * Contador de confirmaciones del día y hora de la última (pausa de 20 s).
       * El id es el número de día; se crea con la primera confirmación del día
       * y solo sube de uno en uno.
       */
      match /limites/{dia} {
        allow read: if esPropietario(userId);
        allow create: if esPropietario(userId)
          && dia == string(numeroDeDia())
          && request.resource.data.keys().hasOnly(['confirmaciones', 'ultimaAt'])
          && request.resource.data.confirmaciones == 1
          && request.resource.data.ultimaAt == request.time;
        allow update: if esPropietario(userId)
          && dia == string(numeroDeDia())
          && request.resource.data.keys().hasOnly(['confirmaciones', 'ultimaAt'])
          && request.resource.data.confirmaciones == resource.data.confirmaciones + 1
          && request.resource.data.ultimaAt == request.time;
        allow delete: if false;
      }

      match /avisos/{docId} {
        allow read: if esPropietario(userId);

        allow create, update: if esPropietario(userId)
          && docId == 'estado'
          && request.resource.data.keys().hasOnly(['vistos', 'vistosHasta', 'updatedAt'])
          && request.resource.data.vistos is list
          && request.resource.data.vistos.size() <= 300
          && (
               !('vistosHasta' in request.resource.data)
               || request.resource.data.vistosHasta == null
               || request.resource.data.vistosHasta is timestamp
             );

        allow delete: if false;
      }
    }

    // --- Reportes ciudadanos (Sprint 2) ------------------------------------

    /**
     * S4-02 · Si la categoría está en el catálogo /categorias, manda el
     * catálogo: solo se acepta si está activa. Si no está, se acepta solo si
     * es una de las 7 históricas; así nada se rompe mientras el catálogo no
     * las tenga cargadas. Cuando existan las 7 en el catálogo, esta lista
     * fija se puede quitar.
     *
     * Se escribe con el operador ternario para leer el documento una sola vez:
     * la creación de un reporte consulta varios documentos, y Firestore limita
     * esas lecturas a 10 por operación. Superar el límite se informa como
     * "permiso denegado", no como un error de cuota.
     */
    function categoriaValida() {
      let categoria = request.resource.data.categoria;
      let ruta = /databases/$(database)/documents/categorias/$(categoria);
      return categoria is string
        && (
             exists(ruta)
               ? get(ruta).data.activa == true
               : categoria in [
                   'microbasural', 'luminaria', 'fuga_agua', 'arbol_peligroso',
                   'calle_deteriorada', 'accesibilidad', 'otro'
                 ]
           );
    }

    function descripcionValida() {
      return request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 10
        && request.resource.data.descripcion.size() <= 500;
    }

    /**
     * Umbral del intervalo entre reportes, en milisegundos.
     * Debe mantenerse igual a INTERVALO_MINIMO_REPORTE_MS en
     * src/app/models/user-profile.model.ts (v2-E2).
     */
    function intervaloMinimoMs() {
      return 30000;
    }

    /**
     * BUG 60 · Intervalo mínimo entre reportes del mismo usuario.
     *
     * Limitación conocida y declarada: las reglas no pueden obligar a que la
     * marca `ultimoReporteAt` se actualice junto con la creación del reporte,
     * porque cada escritura de un lote se evalúa por separado contra el estado
     * previo. Frena el envío repetido desde la aplicación, no a un cliente
     * fabricado a medida; para eso está App Check.
     *
     * v2-E2 · Si el perfil no existe, se admite: las cuentas anteriores a la
     * creación automática del perfil no deben quedar bloqueadas. El perfil se
     * lee una sola vez y se evalúa en `intervaloCumplido`, en lugar de repetir
     * el get() en cada condición.
     */
    function respetaIntervaloDeReporte() {
      let ruta = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(ruta) || intervaloCumplido(get(ruta).data);
    }

    function intervaloCumplido(perfil) {
      return !('ultimoReporteAt' in perfil)
        || perfil.ultimoReporteAt == null
        || request.time.toMillis() - perfil.ultimoReporteAt.toMillis() >= intervaloMinimoMs();
    }

    /**
     * Firma pública de un cambio de estado.
     *
     * `autorRol` debe coincidir con el rol real de quien escribe, leído de su
     * perfil. `autorNombre` es opcional para no romper clientes que aún no lo
     * envían (se muestran como "Autor no registrado"), pero si viene:
     *  - de un admin, es libre: la interfaz lo muestra siempre como
     *    "Administración Ciudad Alerta" a partir del rol;
     *  - de un operador, debe ser exactamente el nombre del organismo al que
     *    pertenece. Así nadie firma un cambio a nombre de otra municipalidad.
     */
    function firmaHistorialValida() {
      let datos = request.resource.data;
      let perfil = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (!('autorRol' in datos) || datos.autorRol == perfil.role)
        && (
             !('autorNombre' in datos)
             || (
                  datos.autorNombre is string
                  && datos.autorNombre.size() > 0
                  && datos.autorNombre.size() <= 120
                  && (perfil.role != 'operador'
                      || datos.autorNombre == nombreOrganismoDeOperador(perfil.operadorId))
                )
           );
    }

    function nombreOrganismoDeOperador(operadorId) {
      let operador = get(/databases/$(database)/documents/operadores/$(operadorId)).data;
      return get(/databases/$(database)/documents/organismos/$(operador.organismoId)).data.nombre;
    }

    function reporteExiste(reportId) {
      return exists(/databases/$(database)/documents/reports/$(reportId));
    }

    function datosReporte(reportId) {
      return get(/databases/$(database)/documents/reports/$(reportId)).data;
    }

    /** Flujo de estados permitido. Debe reflejar TRANSICIONES en report.model.ts. */
    function transicionValida(desde, hacia) {
      return (desde == 'reportado' && hacia in ['en_revision', 'derivado', 'cerrado'])
        || (desde == 'en_revision' && hacia in ['derivado', 'cerrado'])
        || (desde == 'derivado' && hacia in ['en_proceso', 'cerrado'])
        || (desde == 'en_proceso' && hacia in ['resuelto', 'cerrado'])
        || (desde == 'resuelto' && hacia == 'cerrado');
    }

    /**
     * Impide que una actualización de estado altere el contenido del reporte.
     *
     * Además de `estado` y `updatedAt`, acepta los campos de resolución
     * (ETAPA BLANDA: se aceptan, pero NO se exigen, para que ninguna versión
     * de la app que no los escriba deje de funcionar):
     *
     *  - `resueltoAt` y `tiempoResolucionMs`, juntos, solo al pasar a
     *    «resuelto». `resueltoAt` debe ser la hora del servidor. El cliente no
     *    conoce la hora exacta del servidor, así que `tiempoResolucionMs` (los
     *    milisegundos desde `createdAt` hasta ahora, nunca negativo) se acepta
     *    con una tolerancia de 15 minutos respecto de la hora del servidor:
     *    sobra para tiempos de horas o días y no se puede falsear de forma útil.
     *    Si el reloj del dispositivo se desvía más que eso, la escritura se
     *    rechaza; el portal reintenta sin los campos (etapa blanda).
     *  - `cerradoSinResolverAt`, solo al cerrar un reporte que NO pasó por
     *    «resuelto». Debe ser la hora del servidor.
     *
     * Son de escritura única: «resuelto» solo se alcanza desde «en_proceso» y
     * nunca se vuelve atrás, así que cada campo se puede escribir una vez.
     * Los reportes ya cerrados antes de este cambio no se tocan.
     *
     * Etapa estricta (más adelante, cuando todas las versiones de la app
     * escriban estos campos): exigirlos en los casos de arriba.
     */
    function cambioDeEstadoValido() {
      let nuevo = request.resource.data;
      let antes = resource.data;
      let extras = nuevo.diff(antes).affectedKeys()
        .difference(['estado', 'updatedAt'].toSet());
      let alResolver = nuevo.estado == 'resuelto';
      let alCerrarSinResolver = nuevo.estado == 'cerrado' && antes.estado != 'resuelto';
      return extras.size() == 0
        || (
             extras.hasOnly(['resueltoAt', 'tiempoResolucionMs'])
             && extras.hasAll(['resueltoAt', 'tiempoResolucionMs'])
             && alResolver
             && antes.get('resueltoAt', null) == null
             && nuevo.resueltoAt == request.time
             && nuevo.tiempoResolucionMs is int
             && nuevo.tiempoResolucionMs >= 0
             && math.abs(
                  nuevo.tiempoResolucionMs
                  - (request.time.toMillis() - antes.createdAt.toMillis())
                ) <= 900000
           )
        || (
             extras.hasOnly(['cerradoSinResolverAt'])
             && alCerrarSinResolver
             && antes.get('cerradoSinResolverAt', null) == null
             && nuevo.cerradoSinResolverAt == request.time
           );
    }

    /**
     * BUG 27 · Las reglas no pueden recalcular un geohash a partir de las
     * coordenadas, así que se valida su forma: base32 de geohash, de 1 a 12
     * caracteres. Evita cadenas arbitrarias que ensucien las búsquedas.
     */
    function geohashValido() {
      return request.resource.data.geohash is string
        && request.resource.data.geohash.size() > 0
        && request.resource.data.geohash.size() <= 12
        && request.resource.data.geohash.matches('^[0-9b-hjkmnp-z]+$');
    }

    /**
     * BUG 26 · Cota al vector de características para que un cliente
     * manipulado no infle el documento hasta el límite de 1 MiB.
     *
     * La app usa MobileNet v2 con alpha 1.0, cuyo vector tiene 1280
     * dimensiones. La cota original de 1024 correspondía a MobileNet v1 y
     * rechazaba todo reporte con fotografía en cuanto el modelo lograba
     * cargarse. Si se cambia de modelo, este valor debe acompañarlo.
     */
    function embeddingValido() {
      return !('embedding' in request.resource.data)
        || request.resource.data.embedding == null
        || (request.resource.data.embedding is list
            && request.resource.data.embedding.size() <= 1280);
    }

    /**
     * La comuna es opcional (puede no detectarse), pero si viene debe ser un
     * texto acotado. La fuente se restringe a los tres valores conocidos para
     * poder auditar la calidad del dato.
     */
    function comunaValida() {
      let datos = request.resource.data;
      return (!('comuna' in datos) || datos.comuna == null
              || (datos.comuna is string && datos.comuna.size() <= 80))
        && (!('region' in datos) || datos.region == null
              || (datos.region is string && datos.region.size() <= 120))
        && (!('comunaFuente' in datos)
              || datos.comunaFuente in ['limites_oficiales', 'nominatim', 'no_disponible']);
    }

    /**
     * El nombre del autor debe coincidir con el `displayName` de su perfil.
     * Sin esta comprobación, cualquiera podría firmar un reporte con el nombre
     * de otra persona. Las cuentas sin perfil —anteriores a su creación
     * automática— quedan exentas de la comparación, pero no del formato.
     */
    function autorNombreValido() {
      let datos = request.resource.data;
      let perfil = /databases/$(database)/documents/users/$(request.auth.uid);
      return !('autorNombre' in datos)
        || (datos.autorNombre is string
            && datos.autorNombre.size() >= 1
            && datos.autorNombre.size() <= 60
            && (!exists(perfil) || get(perfil).data.displayName == datos.autorNombre));
    }

    /**
     * Toda foto de reporte debe haber pasado por el difuminado de rostros y
     * personas, que la app hace en el teléfono antes de subirla. La regla no
     * puede inspeccionar la imagen, pero sí impide que una versión antigua de
     * la app —sin difuminado— publique fotos: esas versiones no envían este
     * dato.
     */
    function fotoProtegida() {
      let foto = request.resource.data.get('foto', null);
      return foto == null
        || foto.get('privacidad', {}).get('aplicada', false) == true;
    }

    function ubicacionValida() {
      let ubicacion = request.resource.data.ubicacion;
      return ubicacion.lat is number && ubicacion.lat >= -90 && ubicacion.lat <= 90
        && ubicacion.lng is number && ubicacion.lng >= -180 && ubicacion.lng <= 180;
    }

    /**
     * El organismo del reporte debe ser uno de los genéricos de respaldo o una
     * municipalidad que exista realmente en `organismos`. La app móvil lo
     * calcula a partir de la comuna donde se hizo el reporte, y solo usa un
     * genérico cuando la comuna no pudo identificarse.
     */
    function organismoReporteValido() {
      let organismoId = request.resource.data.organismo.id;
      return organismoId is string
        && (
             organismoId in ['muni_aseo', 'muni_obras', 'muni_oirs', 'elec_dist', 'sanitaria']
             || exists(/databases/$(database)/documents/organismos/$(organismoId))
           );
    }

    /**
     * Asignación automática del operador al crear el reporte.
     *
     * La app busca, entre los operadores activos, el que pertenece al
     * organismo del reporte. Esta regla comprueba que la asignación sea
     * coherente: el operador debe existir, estar activo y pertenecer
     * exactamente a ese organismo. Sin la última condición, un cliente podría
     * dirigir un reporte de Maipú al operador de otra municipalidad.
     *
     * `operadorId` es opcional: un organismo sin operadores todavía produce
     * reportes sin asignar, que un admin puede asignar después.
     *
     * Si `operadorId` apunta a un documento inexistente, get() falla y la
     * regla deniega, que es el resultado correcto.
     */
    function operadorReporteValido() {
      let datos = request.resource.data;
      return !('operadorId' in datos)
        || datos.operadorId == null
        || operadorCoherente(
             datos,
             get(/databases/$(database)/documents/operadores/$(datos.operadorId)).data
           );
    }

    function operadorCoherente(datos, operador) {
      return operador.activo == true
        && operador.organismoId == datos.organismo.id;
    }

    /**
     * 1.1 · Lista blanca de la creación: los campos que escriben la app
     * (createReport) y el portal (crearReporteAdmin). Sin ella se podía nacer
     * con campos de resolución o de retiro (resueltoAt, tiempoResolucionMs,
     * retiradoPorAutor…) y falsear las métricas desde el primer minuto.
     */
    function camposDeReporteNuevo() {
      let datos = request.resource.data;
      return datos.keys().hasOnly([
               'uid', 'autorNombre', 'estado', 'confirmaciones', 'descripcion', 'categoria',
               'ubicacion', 'geohash', 'comuna', 'region', 'comunaFuente', 'organismo',
               'operadorId', 'foto', 'embedding', 'validacion', 'origen', 'createdAt', 'updatedAt'
             ])
        && datos.ubicacion.keys().hasOnly(['lat', 'lng', 'accuracy', 'fuente'])
        && (!('fuente' in datos.ubicacion) || datos.ubicacion.fuente in ['gps', 'mapa'])
        && (!('updatedAt' in datos) || datos.updatedAt == request.time)
        // Solo el panel de administración marca sus reportes.
        && (!('origen' in datos) || (datos.origen == 'portal_admin' && esAdministrador()));
    }

    /**
     * 1.1 · La foto de un reporte es la suya: `reportPhotos/{id del reporte}`,
     * subida por quien reporta en el mismo lote (o, con Cloud Storage, su
     * archivo `reports/{uid}/{id}.jpg|png`). Antes se podía apuntar a la foto
     * de otro reporte sin subir ninguna.
     */
    function referenciaDeFotoValida(reportId) {
      let foto = request.resource.data.get('foto', null);
      let base = 'reports/' + request.auth.uid + '/' + reportId;
      return foto == null
        || (
             foto.kind == 'firestore'
             && foto.path == 'reportPhotos/' + reportId
             && getAfter(/databases/$(database)/documents/reportPhotos/$(reportId)).data.ownerUid == request.auth.uid
           )
        || (foto.kind == 'cloud-storage' && foto.path in [base + '.jpg', base + '.png']);
    }

    /**
     * 1.1 · El nombre del organismo es el del catálogo: el de su documento en
     * `organismos` o, para los genéricos, el mismo de ORGANISMOS en
     * models/organismo.model.ts (y del portal). Antes solo se validaba el id y
     * el reporte podía mostrar cualquier nombre.
     */
    function organismoCoincideConCatalogo() {
      let org = request.resource.data.organismo;
      let genericos = {
        'muni_aseo': 'Dirección de Aseo y Ornato',
        'muni_obras': 'Dirección de Obras Municipales',
        'muni_oirs': 'OIRS Municipal',
        'elec_dist': 'Empresa distribuidora eléctrica',
        'sanitaria': 'Empresa sanitaria'
      };
      return org.keys().hasOnly(['id', 'nombre', 'tipo', 'comuna'])
        && org.nombre is string
        && (
             org.id in genericos
               ? org.nombre == genericos[org.id]
               : org.nombre == get(/databases/$(database)/documents/organismos/$(org.id)).data.nombre
           );
    }

    match /reports/{reportId} {
      // El mapa público del MVP es visible para cualquier usuario autenticado.
      allow read: if estaAutenticado();

      allow create: if estaAutenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'reportado'
        && request.resource.data.confirmaciones == 0
        // La fecha la pone el servidor: sin esto se podían crear reportes
        // con fecha falsa (y saltarse los tiempos de respuesta).
        && request.resource.data.createdAt == request.time
        && descripcionValida()
        && categoriaValida()
        && ubicacionValida()
        && geohashValido()
        && embeddingValido()
        && comunaValida()
        && autorNombreValido()
        && organismoReporteValido()
        && organismoCoincideConCatalogo()
        && operadorReporteValido()
        && fotoProtegida()
        && referenciaDeFotoValida(reportId)
        && camposDeReporteNuevo()
        && (!('validacion' in request.resource.data) || validacionInicial(request.resource.data.validacion))
        && respetaIntervaloDeReporte();

      /**
       * Reasignación manual por un admin, desde el panel.
       *
       * Cubre dos casos: reportes creados antes de que existiera la
       * asignación automática, y correcciones cuando la detección se
       * equivocó. Permite cambiar el operador y, si hace falta, el organismo,
       * sin tocar ningún otro campo del reporte.
       *
       * A diferencia de la creación, aquí no se exige que el operador
       * pertenezca al organismo: es una decisión explícita de un admin y debe
       * poder corregir lo que la detección automática hizo mal. Sí se exige
       * que el operador exista y esté activo, y que el organismo exista.
       */
      function reasignacionValida() {
        let datos = request.resource.data;
        return datos.diff(resource.data).affectedKeys()
            .hasOnly(['operadorId', 'organismo', 'updatedAt'])
          && (
               datos.get('operadorId', null) == null
               || get(/databases/$(database)/documents/operadores/$(datos.operadorId)).data.activo == true
             )
          && (
               datos.organismo == resource.data.organismo
               || exists(/databases/$(database)/documents/organismos/$(datos.organismo.id))
             );
      }

      // HU-28 · Solo un admin o el operador asignado al reporte cambia el
      // estado, y solo por transiciones válidas. El resto de campos debe
      // quedar intacto, salvo los campos de resolución (ver cambioDeEstadoValido).
      allow update: if (
             puedeGestionarReporte(resource.data)
             && transicionValida(resource.data.estado, request.resource.data.estado)
             && cambioDeEstadoValido()
           )
        || (esAdministrador() && reasignacionValida())
        // Sistema de confianza: veredicto de un gestor.
        || (puedeGestionarReporte(resource.data) && veredictoValido(reportId))
        // Sistema de confianza: un vecino suma su confirmación.
        || (estaAutenticado() && !esCuentaOperador() && sumaDeConfirmacionValida(reportId))
        // 1.0 · Al eliminar su cuenta, el autor deja anónimos sus reportes.
        || anonimizacionDelAutorValida()
        // 1.0 · Mientras nadie lo revise, el autor corrige la descripción o lo retira.
        || edicionDelAutorValida()
        || retiroDelAutorValido();

      /**
       * 1.0 · Eliminar la cuenta: el autor cambia su nombre por «Cuenta
       * eliminada» en sus reportes, y nada más. El reporte se conserva.
       */
      function anonimizacionDelAutorValida() {
        return estaAutenticado()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autorNombre'])
          && request.resource.data.autorNombre == 'Cuenta eliminada';
      }

      /** El autor, mientras el reporte siga en «reportado». */
      function esAutorSinRevisar() {
        return estaAutenticado()
          && resource.data.uid == request.auth.uid
          && resource.data.estado == 'reportado';
      }

      /**
       * 1.0 · Corregir la descripción: solo ese campo, con su largo y la hora del servidor.
       * 1.1 · Y solo mientras nadie lo haya confirmado con peso: si no, el autor
       * podía cambiar el texto por el que otros vecinos ya votaron.
       */
      function edicionDelAutorValida() {
        return esAutorSinRevisar()
          && validacionDe(resource.data).get('votos', 0) == 0
          && validacionDe(resource.data).get('puntos', 0) == 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['descripcion', 'updatedAt', 'editadoAt'])
          && descripcionValida()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.editadoAt == request.time;
      }

      /**
       * 1.0 · Retirar: pasa a «cerrado» con la hora del servidor y la marca
       * retiradoPorAutor. La entrada del historial la valida statusHistory.
       */
      function retiroDelAutorValido() {
        return esAutorSinRevisar()
          && request.resource.data.estado == 'cerrado'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'updatedAt', 'cerradoSinResolverAt', 'retiradoPorAutor'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.cerradoSinResolverAt == request.time
          && request.resource.data.retiradoPorAutor == true;
      }

      // Solo un admin elimina, desde el panel "Administrar reportes". El
      // panel borra en el mismo lote la foto y las subcolecciones, para no
      // dejar documentos huérfanos.
      allow delete: if esAdministrador();

      // Confirmación comunitaria. El id del documento es el uid de quien
      // confirma, así que un segundo intento sería un update y queda denegado:
      // la unicidad la garantizan la estructura y estas reglas, no el cliente.
      match /confirmations/{userId} {
        allow read: if estaAutenticado();

        // BUG 25 · El reporte debe existir; BUG 10 · nadie confirma lo propio.
        // Dos formatos. El antiguo (solo uid, reportId y createdAt) sigue
        // aceptado mientras la app nueva no esté publicada: cuenta en el conteo
        // de confirmaciones pero no pesa en la validación. El nuevo lleva nivel
        // y peso, y exige la suma en el reporte y el contador del día.
        allow create: if esPropietario(userId)
          && request.resource.data.uid == userId
          && request.resource.data.reportId == reportId
          && request.resource.data.createdAt == request.time
          && reporteExiste(reportId)
          && datosReporte(reportId).uid != request.auth.uid
          // 1.1 · Igual que motivoDeBloqueo() de la app: un reporte resuelto,
          // cerrado (o retirado) o con veredicto ya no se confirma.
          && !(datosReporte(reportId).estado in ['resuelto', 'cerrado'])
          && validacionDe(datosReporte(reportId)).get('veredicto', null) == null
          && !esCuentaOperador()
          && (
               request.resource.data.keys().hasOnly(['uid', 'reportId', 'createdAt'])
               || confirmacionConPesoValida(reportId, userId)
             );

        allow update: if false;
        // Solo al eliminar el reporte completo desde el panel de admin.
        allow delete: if esAdministrador();
      }

      // HU-28 · Bitácora de cambios de estado. Inmutable una vez escrita.
      match /statusHistory/{cambioId} {
        allow read: if estaAutenticado();

        /**
         * BUG 15 · `desde` debe coincidir con el estado que el reporte tiene
         * ahora mismo. Dentro de una transacción, get() devuelve el estado
         * previo a la escritura, que es justamente el origen de la transición.
         * Sin esta comprobación se podía inventar una bitácora que contradijera
         * el documento.
         * BUG 23 · El comentario se acota también en servidor.
         */
        allow create: if request.resource.data.autorUid == request.auth.uid
          // 1.1 · Lista blanca: lo que escriben CambioEstadoService, el retiro
          // del autor (MiReporteService) y el portal (reporte.ts).
          && request.resource.data.keys().hasOnly(['reportId', 'desde', 'hacia', 'autorUid', 'autorRol', 'autorNombre', 'comentario', 'createdAt'])
          && request.resource.data.reportId == reportId
          && request.resource.data.createdAt == request.time
          && reporteExiste(reportId)
          && request.resource.data.desde == datosReporte(reportId).estado
          && request.resource.data.comentario is string
          && request.resource.data.comentario.size() <= 512
          && firmaHistorialValida()
          && (
               // 1.1 · La entrada viaja con el cambio de estado: al final del
               // lote el reporte debe quedar en «hacia». Sin esto, un gestor
               // podía anotar (y notificar) un cambio que nunca hizo.
               (puedeGestionarReporte(datosReporte(reportId))
                 && transicionValida(request.resource.data.desde, request.resource.data.hacia)
                 && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.estado == request.resource.data.hacia)
               // 1.0 · El autor retira su reporte mientras nadie lo ha revisado,
               // en el mismo lote que lo cierra (getAfter ve el resultado).
               || (datosReporte(reportId).uid == request.auth.uid
                 && request.resource.data.desde == 'reportado'
                 && request.resource.data.hacia == 'cerrado'
                 && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.estado == 'cerrado'
                 && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.get('retiradoPorAutor', false) == true)
             );

        allow update: if false;
        // Solo al eliminar el reporte completo desde el panel de admin.
        allow delete: if esAdministrador();
      }
    }

    /**
     * Fotografías guardadas en Firestore mientras el proyecto siga en el plan
     * Spark. El id del documento coincide con el del reporte.
     *
     * BUG 24 · La fotografía y el reporte se escriben en un mismo lote (BUG
     * 61). 1.1 · getAfter() ve el resultado del lote: la foto solo se acepta si
     * al final existe su reporte y es de quien la sube. Antes se podían subir
     * fotos sueltas, sin reporte, hasta llenar la cuota.
     */
    match /reportPhotos/{reportId} {
      allow read: if estaAutenticado();

      allow create: if estaAutenticado()
        && request.resource.data.keys().hasOnly(['reportId', 'ownerUid', 'mimeType', 'dataUrl', 'sizeBytes', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.reportId == reportId
        && request.resource.data.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 950000
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/reports/$(reportId))
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.uid == request.auth.uid;

      // Un admin la borra al eliminar el reporte completo. El autor solo puede
      // limpiar una foto que quedó sin reporte (1.1: antes podía borrar la de
      // un reporte publicado y dejarlo apuntando a una imagen inexistente).
      allow delete: if (estaAutenticado()
            && resource.data.ownerUid == request.auth.uid
            && !exists(/databases/$(database)/documents/reports/$(reportId)))
        || esAdministrador();
      allow update: if false;
    }

    // --- Organismos: municipalidades de Chile --------------------------------

    function organismoValido(organismoId) {
      let datos = request.resource.data;
      return datos.id == organismoId
        && organismoId.matches('^muni_[0-9]{5}$')
        && datos.tipo == 'municipio'
        && datos.nombre is string
        && datos.nombre.size() > 0
        && datos.nombre.size() <= 120
        && datos.comunasAtendidas is list
        && datos.comunasAtendidas.size() >= 1
        && datos.comunasAtendidas.size() <= 5
        && datos.activo is bool
        // Opcional: polígono de la zona que cubre este organismo, editable
        // desde el panel de administración.
        && (
             !('zonaCobertura' in datos)
             || datos.zonaCobertura == null
             || (
                  datos.zonaCobertura.type in ['Polygon', 'MultiPolygon']
                  && datos.zonaCobertura.coordinates is list
                )
           );
    }

    match /organismos/{organismoId} {
      // Cualquier usuario autenticado puede leer el catálogo: se necesita al
      // crear un reporte para asignar su municipalidad.
      allow read: if estaAutenticado();

      /**
       * Solo un administrador lo carga o corrige. Nadie lo borra desde la app:
       * un organismo retirado se marca con `activo: false`, para no dejar
       * reportes históricos apuntando a un documento inexistente.
       *
       * `esCorreoAdministrador()` va primero porque lee el token de sesión,
       * que no cuenta como lectura de documento. La carga del catálogo escribe
       * cientos de documentos en lotes, y Firestore limita a 20 las lecturas
       * por lote: si cada escritura leyera el perfil, el lote se rechazaría
       * con "permiso denegado" aunque el rol fuera correcto.
       */
      allow create, update: if (esCorreoAdministrador() || esAdministrador())
        && organismoValido(organismoId);
      allow delete: if false;
    }

    // --- Categorías: catálogo administrable (S4-02) --------------------------
    // El id del documento es el valor que se guarda en `reporte.categoria`,
    // por eso no se puede cambiar ni borrar: una categoría retirada se marca
    // con `activa: false` y los reportes antiguos siguen mostrando su nombre.

    function categoriaCatalogoValida(categoriaId) {
      let datos = request.resource.data;
      return datos.keys().hasOnly(['id', 'nombre', 'descripcion', 'orden', 'activa', 'createdAt', 'updatedAt'])
        && datos.id == categoriaId
        && categoriaId.matches('^[a-z][a-z0-9_]{2,39}$')
        && datos.nombre is string
        && datos.nombre.size() > 0
        && datos.nombre.size() <= 60
        && (!('descripcion' in datos) || datos.descripcion == null
              || (datos.descripcion is string && datos.descripcion.size() <= 200))
        && datos.orden is int
        && datos.orden >= 0
        && datos.orden <= 999
        && datos.activa is bool
        && datos.updatedAt == request.time;
    }

    match /categorias/{categoriaId} {
      // La app móvil y el portal la leen para ofrecer y mostrar categorías.
      allow read: if estaAutenticado();
      allow create: if esAdministrador()
        && categoriaCatalogoValida(categoriaId)
        && request.resource.data.createdAt == request.time;
      // createdAt no cambia: además impide que un "crear" pise una categoría
      // que ya existe.
      allow update: if esAdministrador()
        && categoriaCatalogoValida(categoriaId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // --- Operadores: quién gestiona los reportes de un organismo -------------
    // A diferencia de /organismos (catálogo externo de municipalidades), esta
    // colección la mantiene el panel de administración: cada operador tiene
    // su propio id y nombre, y apunta a un organismo responsable que ya
    // existe en el catálogo. Las cuentas con role 'operador' referencian un
    // operadorId acá (ver /users).

    function operadorValido(operadorId) {
      let datos = request.resource.data;
      return datos.id == operadorId
        && operadorId.matches('^[a-z][a-z0-9_]{2,39}$')
        && datos.nombre is string
        && datos.nombre.size() > 0
        && datos.nombre.size() <= 120
        // El organismo responsable debe existir de verdad en el catálogo.
        && datos.organismoId is string
        && exists(/databases/$(database)/documents/organismos/$(datos.organismoId))
        && datos.activo is bool
        && (!('telefonoContacto' in datos) || datos.telefonoContacto == null
              || (datos.telefonoContacto is string && datos.telefonoContacto.size() <= 30))
        && (!('correoContacto' in datos) || datos.correoContacto == null
              || (datos.correoContacto is string && datos.correoContacto.size() <= 120))
        && (!('direccionContacto' in datos) || datos.direccionContacto == null
              || (datos.direccionContacto is string && datos.direccionContacto.size() <= 160));
    }

    match /operadores/{operadorId} {
      // La app móvil la necesita leer para asignar el operadorId al crear
      // un reporte, y el portal web para el selector de cuentas.
      allow read: if estaAutenticado();
      allow create, update: if esAdministrador() && operadorValido(operadorId);
      allow delete: if false;
    }

    // --- Soporte: quejas y sugerencias -------------------------------------

    function esAutorDelTicket(ticketId) {
      return estaAutenticado()
        && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid
           == request.auth.uid;
    }

    function ticketValido() {
      let datos = request.resource.data;
      return datos.uid == request.auth.uid
        // 1.1 · Lista blanca: los campos de crearTicket() en support.service.ts.
        && datos.keys().hasOnly([
             'uid', 'autorNombre', 'autorEmail', 'tipo', 'estado', 'asignadoA', 'asunto',
             'lastMessagePreview', 'lastMessageAt', 'createdAt', 'updatedAt'
           ])
        && datos.tipo in ['queja', 'sugerencia']
        && datos.estado == 'abierto'
        && datos.asignadoA == null
        && datos.asunto is string
        && datos.asunto.size() >= 5
        && datos.asunto.size() <= 120
        && datos.lastMessagePreview is string
        && datos.lastMessagePreview.size() <= 100
        // 1.1 · Las fechas son las del servidor (ordenan la bandeja del soporte).
        && datos.createdAt == request.time
        && datos.lastMessageAt == request.time
        && (!('updatedAt' in datos) || datos.updatedAt == request.time)
        && (!('autorNombre' in datos) || (datos.autorNombre is string && datos.autorNombre.size() <= 120))
        // 1.1 · El correo de contacto es el de la sesión: el soporte responde ahí.
        && (!('autorEmail' in datos) || datos.autorEmail == '' || datos.autorEmail == request.auth.token.email);
    }

    /**
     * Al responder o escribir, el cliente actualiza el adelanto del ticket. Se
     * permite solo sobre los campos de actividad, nunca sobre el autor, el tipo
     * ni el asunto.
     */
    function actualizacionDeActividad() {
      let datos = request.resource.data;
      let cambios = datos.diff(resource.data).affectedKeys();
      return cambios.hasOnly(['lastMessageAt', 'lastMessagePreview', 'updatedAt', 'estado', 'asignadoA'])
        && datos.uid == resource.data.uid
        && datos.tipo == resource.data.tipo
        && datos.asunto == resource.data.asunto
        // 1.1 · El mismo tope que al crear, y fechas del servidor.
        && (!cambios.hasAny(['lastMessagePreview'])
            || (datos.lastMessagePreview is string && datos.lastMessagePreview.size() <= 100))
        && (!cambios.hasAny(['lastMessageAt']) || datos.lastMessageAt == request.time)
        && (!cambios.hasAny(['updatedAt']) || datos.updatedAt == request.time);
    }

    /**
     * 1.0 · Eliminar la cuenta: el autor deja sus tickets sin datos de
     * contacto («Cuenta eliminada», sin correo), como promete la página
     * /eliminar-cuenta. Nada más del ticket cambia.
     */
    function anonimizacionDeTicketValida() {
      return estaAutenticado()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autorNombre', 'autorEmail'])
        && request.resource.data.autorNombre == 'Cuenta eliminada'
        && request.resource.data.autorEmail == '';
    }

    function transicionTicketValida(desde, hacia) {
      return (desde == 'abierto' && hacia in ['en_atencion', 'cerrado'])
        || (desde == 'en_atencion' && hacia == 'cerrado')
        || (desde == 'cerrado' && hacia == 'en_atencion')
        || desde == hacia;
    }

    match /supportTickets/{ticketId} {
      // El autor ve lo suyo; el equipo de soporte ve todo.
      allow get: if esGestor() || (estaAutenticado() && resource.data.uid == request.auth.uid);
      /**
       * En una consulta de listado, Firestore evalúa la regla contra cada
       * documento candidato y rechaza la consulta completa si alguno pudiera
       * incumplirla. Así, un ciudadano solo puede listar si su consulta filtra
       * por su propio uid; sin ese filtro, la consulta es rechazada entera.
       */
      allow list: if esGestor()
        || (estaAutenticado() && resource.data.uid == request.auth.uid);

      allow create: if estaAutenticado() && ticketValido();

      // El autor solo mueve la actividad al escribir; el estado lo cambia el
      // equipo de soporte.
      allow update: if (
             actualizacionDeActividad()
             && transicionTicketValida(resource.data.estado, request.resource.data.estado)
             && (
                  esGestor()
                  || (
                       resource.data.uid == request.auth.uid
                       && request.resource.data.estado == resource.data.estado
                       && request.resource.data.asignadoA == resource.data.asignadoA
                     )
                )
           )
        || anonimizacionDeTicketValida();

      // Las conversaciones no se borran: son evidencia de la atención prestada.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if esGestor() || esAutorDelTicket(ticketId);

        /**
         * El primer mensaje viaja en el mismo lote que la creación del ticket.
         * 1.1 · getAfter() ve el ticket tal como queda al final del lote, así
         * que sirve igual para el primer mensaje y para los siguientes. Antes se
         * admitía cualquier mensaje mientras el ticket no existiera (mensajes en
         * tickets inexistentes).
         *
         * La firma es la del rol real: «staff» solo el equipo de soporte y
         * «ciudadano» solo quien abrió el ticket (antes un gestor podía firmar
         * como el vecino).
         */
        allow create: if estaAutenticado()
          && request.resource.data.keys().hasOnly(['ticketId', 'autorUid', 'autorNombre', 'autorRol', 'texto', 'createdAt'])
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.ticketId == ticketId
          && request.resource.data.createdAt == request.time
          && request.resource.data.texto is string
          && request.resource.data.texto.size() >= 2
          && request.resource.data.texto.size() <= 1000
          && (!('autorNombre' in request.resource.data)
              || (request.resource.data.autorNombre is string && request.resource.data.autorNombre.size() <= 120))
          && existsAfter(/databases/$(database)/documents/supportTickets/$(ticketId))
          && (
               (request.resource.data.autorRol == 'staff' && esGestor())
               || (request.resource.data.autorRol == 'ciudadano'
                   && getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid)
             );

        // Los mensajes son inmutables: nadie reescribe lo que ya dijo.
        allow update, delete: if false;
      }
    }

    // --- Denegación por defecto -------------------------------------------
    // Cualquier ruta no declarada arriba queda bloqueada.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
